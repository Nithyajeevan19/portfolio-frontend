{
  "name": "CaseStudy",
  "type": "object",
  "properties": {
    "project_title": {
      "type": "string",
      "description": "Project title"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "hero_image": {
      "type": "string",
      "description": "Hero image URL"
    },
    "industry_category": {
      "type": "string",
      "enum": ["Fintech", "SaaS", "Luxury", "Web3"],
      "description": "Industry category"
    },
    "services": {
      "type": "string",
      "description": "Services provided (comma-separated)"
    },
    "year": {
      "type": "string",
      "description": "Project year"
    },
    "the_context": {
      "type": "string",
      "description": "Brief background of the client"
    },
    "the_challenge": {
      "type": "string",
      "description": "The specific business/UX problem"
    },
    "the_approach": {
      "type": "string",
      "description": "Cross-functional execution details"
    },
    "visual_gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery image URLs"
    },
    "the_impact": {
      "type": "string",
      "description": "Data-driven results"
    },
    "impact_metric_1": {
      "type": "string",
      "description": "Primary metric (e.g. +45%)"
    },
    "impact_label_1": {
      "type": "string",
      "description": "Label for metric 1"
    },
    "impact_metric_2": {
      "type": "string",
      "description": "Secondary metric"
    },
    "impact_label_2": {
      "type": "string",
      "description": "Label for metric 2"
    },
    "live_site_link": {
      "type": "string",
      "description": "Live site URL"
    },
    "featured": {
      "type": "boolean",
      "default": true,
      "description": "Show on homepage"
    },
    "grid_size": {
      "type": "string",
      "enum": ["large", "small"],
      "default": "large",
      "description": "Card size in portfolio grid"
    }
  },
  "required": ["project_title", "client_name"]
}
